    { title: 'Valuación física', body: 'Las unidades elegibles se revisan individualmente, incluyendo versión, condición y mercado.' },
    { title: 'Propuesta formal', body: 'SWIP presenta la estructura, monto y condiciones aplicables al expediente aprobado.' },
  ]}
