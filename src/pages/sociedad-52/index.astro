---
import Base from '../../layouts/Base.astro';

const WHATSAPP_NUMBER = '5215542317035';

const faqs = [
  {
    q: '¿Cuándo abrirá Sociedad 52?',
    a: 'La Comunidad abrirá cuando estén aprobados los 52 miembros fundadores y exista una mezcla suficiente de oportunidades, compradores, especialistas y una primera experiencia preparada. No abriremos un grupo vacío.',
  },
  {
    q: '¿Qué sucede si soy aprobado antes de completar los 52?',
    a: 'Recibirás una Founding Letter y actualizaciones privadas mientras se forma la generación completa. El acceso se activa de manera simultánea para todos los fundadores.',
  },
  {
    q: '¿Los fundadores podrán invitar a otras personas?',
    a: 'Sí. Después de conformar la primera generación, cada fundador podrá proponer hasta tres personas para consideración. Una referencia abre la revisión, pero nunca garantiza admisión.',
  },
  {
    q: '¿Puedo entrar directamente desde un enlace de WhatsApp?',
    a: 'No. El enlace de la Comunidad nunca se publica. Cada ingreso requiere solicitud, revisión, una conversación breve y una invitación enviada personalmente.',
  },
  {
    q: '¿Enviar una solicitud garantiza el acceso?',
    a: 'No. Cada perfil se revisa personalmente. Un candidato puede quedar en revisión, ser preseleccionado, aprobado como fundador, considerado para una futura generación o no seleccionado.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Sociedad 52 — Comunidad privada del ecosistema SWIP',
    description: 'Sociedad 52 está seleccionando a sus 52 miembros fundadores: una comunidad privada de activos de alto valor, conexiones verificadas y oportunidades off-market en México.',
    url: 'https://swip.mx/sociedad-52/',
    inLanguage: 'es-MX',
    isPartOf: { '@id': 'https://swip.mx/#website' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<Base
  title="Sociedad 52 | Selección de los 52 Miembros Fundadores"
  description="Sociedad 52 selecciona a 52 miembros fundadores para una comunidad privada de activos de alto valor y oportunidades off-market en México."
  schema={schema}
  disableChatWidget={true}
>
  <header class="landing-header">
    <p>SOCIEDAD 52</p>
    <span>FOUNDING 01—52 · MÉXICO</span>
  </header>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">SOCIEDAD 52</p>
        <h1>México,<br /><em>por invitación.</em></h1>
        <p class="hero-body">
          Una comunidad privada para propietarios, empresarios, compradores,
          coleccionistas y especialistas relacionados con activos de alto valor.
        </p>
        <p class="founding-statement">Actualmente seleccionamos a los 52 miembros fundadores.</p>
        <div class="hero-actions">
          <a href="#solicitud" class="btn-primary" data-cta="sociedad_hero_application">
            Iniciar mi evaluación
          </a>
        </div>
        <p class="hero-note">
          La Comunidad abrirá cuando la primera generación esté completa y
          preparada. La solicitud no garantiza admisión.
        </p>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <span class="mark-plus">+</span>
        <span class="mark-number">52</span>
        <p>ACCESO · CRITERIO · DISCRECIÓN</p>
      </div>
    </section>

    <section class="signal-bar" aria-label="Principios de Sociedad 52">
      <div><span>52</span><p>Miembros fundadores</p></div>
      <div><span>15+</span><p>Oportunidades reales</p></div>
      <div><span>10+</span><p>Compradores activos</p></div>
      <div><span>5+</span><p>Especialistas confiables</p></div>
    </section>

    <section class="content-section" id="estandar">
      <div class="section-inner two-col">
        <div>
          <p class="section-eyebrow">EL ESTÁNDAR</p>
          <h2>Acceso antes que exposición.</h2>
        </div>
        <div class="section-copy">
          <p>
            Los grupos privados pierden valor cuando aceptan a cualquiera,
            mezclan conversación con inventario masivo y permiten que el
            directorio se convierta en una lista de prospección.
          </p>
          <p>
            Sociedad 52 se construye antes de abrir: revisión humana, una
            generación equilibrada, oportunidades reales y compradores con
            solicitudes concretas.
          </p>
          <p>
            La promesa es acceso a oportunidades que normalmente no se
            publican, conexiones confiables y una comunidad verificada alrededor
            de autos premium, blindados, relojes, propiedades y servicios
            especializados.
          </p>
        </div>
      </div>
      <div class="not-grid" aria-label="Lo que Sociedad 52 no es">
        <p>No es un grupo de anuncios.</p>
        <p>No es un marketplace.</p>
        <p>No es una red de brokers.</p>
        <p>No es un club para presumir.</p>
        <p>No es una comunidad abierta.</p>
      </div>
    </section>

    <section class="content-section" id="criterios">
      <div class="section-inner">
        <p class="section-eyebrow">QUÉ EVALUAMOS</p>
        <h2 class="section-title">No buscamos estatus.<br />Buscamos compatibilidad.</h2>
        <p class="section-lead">
          Revisamos cada perfil de forma humana para construir una primera
          generación equilibrada, confiable y capaz de aportar valor desde el
          inicio.
        </p>
        <div class="rules-grid">
          <article>
            <span>01</span>
            <h3>Trayectoria verificable</h3>
            <p>Identidad, actividad y reputación que podamos comprender y validar sin solicitar información patrimonial sensible.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Valor para la comunidad</h3>
            <p>Experiencia, criterio, oportunidades, necesidades concretas o relaciones que ayuden a construir una red útil.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Alineación con el estándar</h3>
            <p>Discreción, respeto a la privacidad, cero prospección fría y disposición para participar sin ruido ni intermediación opaca.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="content-section" id="proceso">
      <div class="section-inner">
        <p class="section-eyebrow">EL PROCESO</p>
        <h2 class="section-title">Una evaluación.<br />Tres momentos.</h2>
        <p class="section-lead">
          La solicitud no entrega acceso automático. Nos permite conocerte,
          revisar el encaje y decidir el siguiente paso.
        </p>
        <div class="admission-grid compact">
          <article>
            <span>01</span>
            <h3>Evaluación inicial</h3>
            <p>Comparte quién eres, cómo participas, qué buscas y qué podrías aportar a la generación fundadora.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Revisión privada</h3>
            <p>Validamos identidad, trayectoria, intención y la forma en que tu perfil complementa a los primeros 52.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Conversación de admisión</h3>
            <p>Los perfiles preseleccionados reciben una invitación para una llamada breve antes de cualquier aprobación.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="application-section" id="solicitud">
      <div class="application-intro">
        <p class="section-eyebrow">PERFIL DE FUNDADOR</p>
        <h2>Una presentación breve.</h2>
        <p>
          Comparte lo esencial para solicitar consideración. Completar este
          perfil toma menos de 90 segundos.
        </p>
        <div class="application-note">
          <span>QUÉ SIGUE</span>
          <p>Ramón revisa personalmente cada perfil. Si existe compatibilidad, recibirás una invitación para una conversación breve.</p>
        </div>
      </div>

      <form class="application-form" id="sociedad-application-form">
        <div class="form-heading field-wide">
          <span>PERFIL INICIAL</span>
          <h3>Solicita consideración.</h3>
          <p>Solo pedimos la información necesaria para decidir si tiene sentido conversar.</p>
        </div>

        <label>
          Nombre completo
          <input type="text" name="nombre" autocomplete="name" required />
        </label>
        <label>
          WhatsApp
          <input type="tel" name="whatsapp" autocomplete="tel" required />
        </label>
        <label>
          Ciudad
          <input type="text" name="ciudad" autocomplete="address-level2" required />
        </label>
        <label>
          ¿A qué te dedicas?
          <input
            type="text"
            name="actividad"
            maxlength="160"
            placeholder="Empresa, industria o proyecto principal"
            required
          />
        </label>
        <label>
          LinkedIn, empresa o perfil público
          <input type="text" name="perfil" maxlength="240" placeholder="URL o usuario" />
          <small>Opcional. Nos ayuda a conocer tu trayectoria.</small>
        </label>
        <label>
          ¿Quién te recomendó?
          <input type="text" name="referido" maxlength="160" placeholder="Nombre o relación" />
          <small>Opcional. También puedes indicar cómo nos conociste.</small>
        </label>
        <label class="field-wide">
          En una frase, ¿qué buscas o qué podrías aportar a Sociedad 52?
          <textarea
            name="encaje"
            rows="3"
            maxlength="240"
            placeholder="Una conexión específica, experiencia, acceso, oportunidades directas o criterio especializado."
            required
          ></textarea>
        </label>
        <label class="consent field-wide">
          <input type="checkbox" name="consentimiento" required />
          <span>
            Acepto el contacto para revisar mi perfil y confirmo haber leído
            el <a href="/aviso-de-privacidad/" target="_blank">aviso de privacidad</a>.
            Entiendo que la solicitud no garantiza admisión.
          </span>
        </label>
        <p class="form-disclaimer field-wide">
          No compartas identificaciones, estados de cuenta, domicilios exactos
          ni información patrimonial sensible. Al continuar se abrirá WhatsApp
          para que confirmes el envío.
        </p>
        <button type="submit" class="form-submit field-wide">Solicitar consideración →</button>
      </form>
    </section>

    <section class="content-section faq-section">
      <div class="section-inner faq-grid">
        <div>
          <p class="section-eyebrow">PREGUNTAS FRECUENTES</p>
          <h2 class="section-title">Antes de iniciar<br />tu evaluación.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <p class="section-eyebrow">SOCIEDAD 52 · COHORTE FUNDADORA</p>
      <h2>Estamos seleccionando a<br />los 52 miembros fundadores.</h2>
      <p>
        La Comunidad abrirá cuando existan las personas, oportunidades,
        compradores, especialistas y experiencia necesarias para comenzar viva.
      </p>
      <a href="#solicitud" class="btn-primary" data-cta="sociedad_final_application">
        Iniciar mi evaluación
      </a>
    </section>
  </main>
  <footer class="landing-footer">
    <p>SOCIEDAD 52 · MÉXICO</p>
    <span>Acceso privado. Evaluación personal.</span>
    <a href="/aviso-de-privacidad/" target="_blank">Aviso de privacidad</a>
  </footer>

  <script define:vars={{ WHATSAPP_NUMBER }}>
    const form = document.getElementById('sociedad-application-form');

    document.querySelectorAll('[data-cta]').forEach((element) => {
      element.addEventListener('click', () => {
        window.gtag('event', 'sociedad_52_cta', {
          cta: element.getAttribute('data-cta'),
        });
      });
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);

      const message = [
        'Hola Ramón, quiero solicitar consideración para la generación fundadora de Sociedad 52.',
        '',
        `Nombre: ${data.get('nombre')}`,
        `WhatsApp: ${data.get('whatsapp')}`,
        `Ciudad: ${data.get('ciudad')}`,
        `Actividad: ${data.get('actividad')}`,
        `Perfil verificable: ${data.get('perfil') || 'No indicado'}`,
        `Recomendación u origen: ${data.get('referido') || 'No indicado'}`,
        `Encaje: ${data.get('encaje')}`,
        '',
        'Entiendo que esta solicitud no garantiza admisión.',
      ].join('\n');

      window.gtag('event', 'sociedad_52_application_submitted', {
        has_referral: Boolean(data.get('referido')),
        has_public_profile: Boolean(data.get('perfil')),
      });

      window.open(
        `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`,
        '_blank',
        'noopener'
      );
    });
  </script>
</Base>

<style>
  main { padding-top: 0; }

  [hidden] { display: none !important; }

  :global(html),
  :global(body) {
    overflow-x: hidden;
  }

  .landing-header {
    min-height: 70px;
    padding: 0 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid var(--line);
    background: #090909;
  }

  .landing-header p,
  .landing-header span,
  .landing-footer p,
  .landing-footer span,
  .landing-footer a {
    font-size: 9px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .landing-header p { color: rgba(255, 255, 255, 0.92); }
  .landing-header span { color: rgba(168, 168, 168, 0.38); }

  #estandar,
  #espacios,
  #admision,
  #solicitud {
    scroll-margin-top: 72px;
  }

  .hero {
    width: 100%;
    max-width: 1440px;
    min-height: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hero-copy {
    min-width: 0;
    padding: 112px 72px 96px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow,
  .section-eyebrow {
    font-size: 9px;
    letter-spacing: 0.4em;
    color: rgba(168, 168, 168, 0.52);
    text-transform: uppercase;
  }

  .eyebrow { margin-bottom: 28px; }

  .hero h1 {
    max-width: 760px;
    font-size: clamp(56px, 6.2vw, 94px);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.94;
    color: var(--white);
  }

  .hero h1 em {
    display: inline-block;
    color: rgba(168, 168, 168, 0.5);
    font-style: normal;
  }

  .hero-body {
    max-width: 660px;
    margin-top: 32px;
    font-size: 16px;
    line-height: 1.85;
    color: rgba(168, 168, 168, 0.76);
  }

  .founding-statement {
    max-width: 620px;
    margin-top: 22px;
    padding-left: 18px;
    border-left: 1px solid rgba(255, 255, 255, 0.26);
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 38px;
  }

  .btn-primary,
  .form-submit {
    min-height: 52px;
    padding: 16px 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: none;
    color: var(--white);
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary:hover,
  .form-submit:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .btn-ghost {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: rgba(168, 168, 168, 0.6);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
  }

  .btn-ghost:hover { color: var(--white); }

  .hero-note {
    max-width: 620px;
    margin-top: 20px;
    font-size: 11px;
    line-height: 1.7;
    color: rgba(168, 168, 168, 0.38);
  }

  .hero-mark {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    border-left: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent 55%),
      #090909;
  }

  .mark-plus,
  .mark-number {
    position: relative;
    color: rgba(255, 255, 255, 0.94);
    font-weight: 200;
    line-height: 0.8;
    letter-spacing: -0.08em;
  }

  .mark-plus {
    align-self: flex-start;
    margin-top: 225px;
    font-size: clamp(64px, 7vw, 108px);
    color: rgba(168, 168, 168, 0.34);
  }

  .mark-number {
    font-size: clamp(180px, 22vw, 330px);
  }

  .hero-mark::before,
  .hero-mark::after {
    content: '';
    position: absolute;
    inset: 8%;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transform: rotate(45deg);
  }

  .hero-mark::after {
    inset: 20%;
    border-color: rgba(255, 255, 255, 0.035);
  }

  .hero-mark p {
    position: absolute;
    bottom: 34px;
    font-size: 8px;
    letter-spacing: 0.42em;
    color: rgba(168, 168, 168, 0.2);
  }

  .signal-bar {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .signal-bar div {
    min-height: 112px;
    padding: 28px 30px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .signal-bar div:last-child { border-right: 0; }
  .signal-bar span {
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--green);
  }
  .signal-bar p {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(168, 168, 168, 0.62);
    text-transform: uppercase;
  }

  .content-section { border-bottom: 1px solid var(--line); }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 104px 64px;
  }

  .two-col,
  .faq-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 100px;
  }

  .content-section h2,
  .application-section h2,
  .final-cta h2 {
    font-size: clamp(36px, 4.5vw, 64px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  .section-title { margin-top: 20px; }

  .section-lead {
    max-width: 620px;
    margin-top: 24px;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(168, 168, 168, 0.7);
  }

  .section-copy p {
    margin-bottom: 22px;
    font-size: 16px;
    line-height: 1.9;
    color: rgba(168, 168, 168, 0.76);
  }

  .section-copy p:last-child { margin-bottom: 0; }

  .not-grid {
    max-width: 1152px;
    margin: -40px auto 104px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .not-grid p {
    min-height: 96px;
    padding: 24px 20px;
    display: flex;
    align-items: center;
    background: var(--black);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.12em;
    color: rgba(168, 168, 168, 0.58);
    text-transform: uppercase;
  }

  .spaces-grid {
    margin-top: 58px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .space-card {
    min-height: 310px;
    padding: 36px 30px;
    background: var(--black);
  }

  .space-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 34px;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.48);
  }

  .space-top span:first-child {
    font-size: 10px;
    letter-spacing: 0.24em;
    color: rgba(168, 168, 168, 0.28);
  }

  .space-access {
    margin-bottom: 14px;
    font-size: 9px !important;
    letter-spacing: 0.24em;
    color: rgba(168, 168, 168, 0.38) !important;
    text-transform: uppercase;
  }

  .space-card h3,
  .rules-grid h3,
  .admission-grid h3 {
    margin-bottom: 14px;
    font-size: 21px;
    font-weight: 300;
    color: var(--white);
  }

  .space-card > p:last-child,
  .rules-grid p,
  .admission-grid p {
    font-size: 13px;
    line-height: 1.75;
    color: rgba(168, 168, 168, 0.66);
  }

  .protocol-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 96px;
    align-items: center;
  }

  .protocol-copy h2 { margin-top: 20px; }
  .protocol-copy > p:last-child {
    max-width: 500px;
    margin-top: 26px;
    font-size: 15px;
    line-height: 1.85;
    color: rgba(168, 168, 168, 0.7);
  }

  .protocol-card {
    padding: 42px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #080808;
  }

  .protocol-status {
    margin-bottom: 30px;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: var(--green);
  }

  .protocol-card dl div {
    padding: 16px 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 20px;
  }

  .protocol-card dt {
    font-size: 9px;
    letter-spacing: 0.18em;
    color: rgba(168, 168, 168, 0.36);
