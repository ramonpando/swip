    { href: '/blog/plan-piso-vs-garantia-de-inventario-vehicular/', label: 'COMPARATIVA', description: 'Plan piso vs. liquidez respaldada por inventario vehicular: diferencias clave.' },
    { href: '/blog/autos-propios-vs-consignacion-como-garantia/', label: 'DOCUMENTACIÓN', description: 'Autos propios y unidades en consignación: cuáles pueden respaldar una operación.' },
    { href: '/blog/como-financiar-una-empresa-blindadora/', label: 'BLINDADORAS', description: 'Cómo financiar una blindadora usando vehículos propios y terminados.' },
    { href: '/blog/prestamo-con-garantia-de-auto-para-financiar-tu-negocio/', label: 'EMPRESARIOS', description: 'Cuándo conviene usar un vehículo para financiar una necesidad del negocio.' },
    { href: '/blog/como-valuamos-un-auto-proceso-real/', label: 'VALUACIÓN', description: 'El proceso real con el que SWIP revisa un vehículo antes de hacer una oferta.' },
