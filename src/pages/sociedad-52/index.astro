---
import Base from '../../layouts/Base.astro';

const WHATSAPP_NUMBER = '5215542317035';

const participationProfiles = [
  'Propietario de activos',
  'Comprador activo',
  'Coleccionista',
  'Empresario o profesionista',
  'Especialista',
  'Partner comercial',
];

const interestCategories = [
  'Autos premium',
  'Blindados',
  'Relojes',
  'Propiedades',
  'Liquidez sobre activos',
  'Conexiones empresariales',
  'Servicios especializados',
];

const faqs = [
  {
    q: '¿Cuándo abrirá Sociedad 52?',
    a: 'La Comunidad abrirá cuando estén aprobados los 52 miembros fundadores y exista una mezcla suficiente de oportunidades, compradores, especialistas y una primera experiencia preparada. No abriremos un grupo vacío.',
  },
  {
    q: '¿Qué sucede si soy aprobado antes de completar los 52?',
    a: 'Recibirás una Founding Letter y actualizaciones privadas mientras se forma la generación completa. El acceso se activa de manera simultánea para todos los fundadores.',
  },
  {
    q: '¿Los fundadores podrán invitar a otras personas?',
    a: 'Sí. Después de conformar la primera generación, cada fundador podrá proponer hasta tres personas para consideración. Una referencia abre la revisión, pero nunca garantiza admisión.',
  },
  {
    q: '¿Puedo entrar directamente desde un enlace de WhatsApp?',
    a: 'No. El enlace de la Comunidad nunca se publica. Cada ingreso requiere solicitud, revisión, una conversación breve y una invitación enviada personalmente.',
  },
  {
    q: '¿Enviar una solicitud garantiza el acceso?',
    a: 'No. Cada perfil se revisa personalmente. Un candidato puede quedar en revisión, ser preseleccionado, aprobado como fundador, considerado para una futura generación o no seleccionado.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Sociedad 52 — Comunidad privada del ecosistema SWIP',
    description: 'Sociedad 52 está seleccionando a sus 52 miembros fundadores: una comunidad privada de activos de alto valor, conexiones verificadas y oportunidades off-market en México.',
    url: 'https://swip.mx/sociedad-52/',
    inLanguage: 'es-MX',
    isPartOf: { '@id': 'https://swip.mx/#website' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<Base
  title="Sociedad 52 | Selección de los 52 Miembros Fundadores"
  description="Estamos seleccionando a los 52 miembros fundadores de Sociedad 52, una comunidad privada en México para activos de alto valor, conexiones verificadas y oportunidades off-market."
  schema={schema}
  disableChatWidget={true}
>
  <header class="landing-header">
    <p>SOCIEDAD 52</p>
    <span>FOUNDING 01—52 · MÉXICO</span>
  </header>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">SOCIEDAD 52</p>
        <h1>México,<br /><em>por invitación.</em></h1>
        <p class="hero-body">
          Una comunidad privada para propietarios, empresarios, compradores,
          coleccionistas y especialistas relacionados con activos de alto valor.
        </p>
        <p class="founding-statement">Actualmente seleccionamos a los 52 miembros fundadores.</p>
        <div class="hero-actions">
          <a href="#solicitud" class="btn-primary" data-cta="sociedad_hero_application">
            Iniciar mi evaluación
          </a>
        </div>
        <p class="hero-note">
          La Comunidad abrirá cuando la primera generación esté completa y
          preparada. La solicitud no garantiza admisión.
        </p>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <span class="mark-plus">+</span>
        <span class="mark-number">52</span>
        <p>ACCESO · CRITERIO · DISCRECIÓN</p>
      </div>
    </section>

    <section class="signal-bar" aria-label="Principios de Sociedad 52">
      <div><span>52</span><p>Miembros fundadores</p></div>
      <div><span>15+</span><p>Oportunidades reales</p></div>
      <div><span>10+</span><p>Compradores activos</p></div>
      <div><span>5+</span><p>Especialistas confiables</p></div>
    </section>

    <section class="content-section" id="estandar">
      <div class="section-inner two-col">
        <div>
          <p class="section-eyebrow">EL ESTÁNDAR</p>
          <h2>Acceso antes que exposición.</h2>
        </div>
        <div class="section-copy">
          <p>
            Los grupos privados pierden valor cuando aceptan a cualquiera,
            mezclan conversación con inventario masivo y permiten que el
            directorio se convierta en una lista de prospección.
          </p>
          <p>
            Sociedad 52 se construye antes de abrir: revisión humana, una
            generación equilibrada, oportunidades reales y compradores con
            solicitudes concretas.
          </p>
          <p>
            La promesa es acceso a oportunidades que normalmente no se
            publican, conexiones confiables y una comunidad verificada alrededor
            de autos premium, blindados, relojes, propiedades y servicios
            especializados.
          </p>
        </div>
      </div>
      <div class="not-grid" aria-label="Lo que Sociedad 52 no es">
        <p>No es un grupo de anuncios.</p>
        <p>No es un marketplace.</p>
        <p>No es una red de brokers.</p>
        <p>No es un club para presumir.</p>
        <p>No es una comunidad abierta.</p>
      </div>
    </section>

    <section class="content-section" id="criterios">
      <div class="section-inner">
        <p class="section-eyebrow">QUÉ EVALUAMOS</p>
        <h2 class="section-title">No buscamos estatus.<br />Buscamos compatibilidad.</h2>
        <p class="section-lead">
          Revisamos cada perfil de forma humana para construir una primera
          generación equilibrada, confiable y capaz de aportar valor desde el
          inicio.
        </p>
        <div class="rules-grid">
          <article>
            <span>01</span>
            <h3>Trayectoria verificable</h3>
            <p>Identidad, actividad y reputación que podamos comprender y validar sin solicitar información patrimonial sensible.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Valor para la comunidad</h3>
            <p>Experiencia, criterio, oportunidades, necesidades concretas o relaciones que ayuden a construir una red útil.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Alineación con el estándar</h3>
            <p>Discreción, respeto a la privacidad, cero prospección fría y disposición para participar sin ruido ni intermediación opaca.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="content-section" id="proceso">
      <div class="section-inner">
        <p class="section-eyebrow">EL PROCESO</p>
        <h2 class="section-title">Una evaluación.<br />Tres momentos.</h2>
        <p class="section-lead">
          La solicitud no entrega acceso automático. Nos permite conocerte,
          revisar el encaje y decidir el siguiente paso.
        </p>
        <div class="admission-grid compact">
          <article>
            <span>01</span>
            <h3>Evaluación inicial</h3>
            <p>Comparte quién eres, cómo participas, qué buscas y qué podrías aportar a la generación fundadora.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Revisión privada</h3>
            <p>Validamos identidad, trayectoria, intención y la forma en que tu perfil complementa a los primeros 52.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Conversación de admisión</h3>
            <p>Los perfiles preseleccionados reciben una invitación para una llamada breve antes de cualquier aprobación.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="application-section" id="solicitud">
      <div class="application-intro">
        <p class="section-eyebrow">EVALUACIÓN PRIVADA</p>
        <h2>Cuéntanos quién eres.</h2>
        <p>
          Completa esta evaluación para ser considerado en la primera generación
          de 52. No solicitamos información patrimonial ni documentos sensibles.
        </p>
        <div class="application-note">
          <span>QUÉ SIGUE</span>
          <p>Revisaremos tu perfil personalmente. Si existe compatibilidad, recibirás una invitación para una conversación breve.</p>
        </div>
      </div>

      <form class="application-form" id="sociedad-application-form">
        <div class="form-progress field-wide" aria-label="Progreso de la evaluación">
          <span class="progress-label">PASO <strong id="current-step">1</strong> DE 3</span>
          <span class="progress-track"><span id="progress-fill"></span></span>
        </div>

        <div class="form-step active field-wide" data-step="1">
          <div class="step-heading">
            <span>01</span>
            <div>
              <h3>Tu perfil</h3>
              <p>Información básica para identificarte y poder contactarte.</p>
            </div>
          </div>
          <div class="step-fields">
            <label>
              Nombre completo
              <input type="text" name="nombre" autocomplete="name" required />
            </label>
            <label>
              WhatsApp
              <input type="tel" name="whatsapp" autocomplete="tel" required />
            </label>
            <label>
              Correo
              <input type="email" name="correo" autocomplete="email" required />
            </label>
            <label>
              Ciudad
              <input type="text" name="ciudad" autocomplete="address-level2" required />
            </label>
            <label class="field-wide">
              Empresa, actividad o profesión
              <input type="text" name="actividad" required />
            </label>
            <label>
              LinkedIn, sitio web o red verificable
              <input type="url" name="perfil" placeholder="https://" />
            </label>
            <label>
              ¿Quién te recomienda?
              <input type="text" name="referido" placeholder="Nombre o relación" />
            </label>
          </div>
        </div>

        <div class="form-step field-wide" data-step="2" hidden>
          <div class="step-heading">
            <span>02</span>
            <div>
              <h3>Tu participación</h3>
              <p>Selecciona todas las opciones que describan tu perfil e intereses.</p>
            </div>
          </div>
          <div class="step-fields">
            <fieldset class="field-wide">
              <legend>¿Cuál describe mejor tu participación?</legend>
              <div class="checkbox-grid">
                {participationProfiles.map((profile) => (
                  <label class="check-option">
                    <input type="checkbox" name="participacion" value={profile} />
                    <span>{profile}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <fieldset class="field-wide">
              <legend>Categorías de interés</legend>
              <div class="checkbox-grid">
                {interestCategories.map((category) => (
                  <label class="check-option">
                    <input type="checkbox" name="categorias" value={category} />
                    <span>{category}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </div>
        </div>

        <div class="form-step field-wide" data-step="3" hidden>
          <div class="step-heading">
            <span>03</span>
            <div>
              <h3>Compatibilidad</h3>
              <p>Ayúdanos a comprender lo que buscas y el valor que puedes aportar.</p>
            </div>
          </div>
          <div class="step-fields">
            <label class="field-wide">
              ¿Qué podrías aportar a Sociedad 52?
              <textarea name="aporte" rows="4" required></textarea>
            </label>
            <label class="field-wide">
              ¿Qué esperas encontrar?
              <textarea name="busca" rows="3" required></textarea>
            </label>
            <label class="field-wide">
              Describe una oportunidad o necesidad actual
              <textarea
                name="oportunidad"
                rows="4"
                placeholder="Ej. vehículo que buscas, activo que quieres colocar, propiedad off-market, necesidad de liquidez o conexión específica."
                required
              ></textarea>
            </label>
            <label class="field-wide">
              ¿Qué relación tienes con SWIP?
              <select name="relacion_swip" required>
                <option value="" selected disabled>Selecciona una opción</option>
                <option>Cliente</option>
                <option>Referido</option>
                <option>Contacto profesional</option>
                <option>Todavía ninguna</option>
              </select>
            </label>
            <label class="field-wide">
              ¿Por qué deberíamos considerarte?
              <textarea name="motivo" rows="3" required></textarea>
            </label>
            <label class="consent field-wide">
              <input type="checkbox" name="consentimiento" required />
              <span>
                Acepto el contacto para revisar mi solicitud y confirmo haber leído
                el <a href="/aviso-de-privacidad/" target="_blank">aviso de privacidad</a>.
                Entiendo que la evaluación no garantiza admisión.
              </span>
            </label>
            <p class="form-disclaimer field-wide">
              No compartas identificaciones, estados de cuenta, domicilios exactos,
              números de serie ni expedientes de activos.
            </p>
          </div>
        </div>

        <div class="form-navigation field-wide">
          <button type="button" class="form-back" id="form-back" hidden>← Regresar</button>
          <button type="button" class="form-next" id="form-next">Continuar evaluación →</button>
          <button type="submit" class="form-submit" id="form-submit" hidden>Enviar mi evaluación →</button>
        </div>
      </form>
    </section>

    <section class="content-section faq-section">
      <div class="section-inner faq-grid">
        <div>
          <p class="section-eyebrow">PREGUNTAS FRECUENTES</p>
          <h2 class="section-title">Antes de iniciar<br />tu evaluación.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <p class="section-eyebrow">SOCIEDAD 52 · COHORTE FUNDADORA</p>
      <h2>Estamos seleccionando a<br />los 52 miembros fundadores.</h2>
      <p>
        La Comunidad abrirá cuando existan las personas, oportunidades,
        compradores, especialistas y experiencia necesarias para comenzar viva.
      </p>
      <a href="#solicitud" class="btn-primary" data-cta="sociedad_final_application">
        Iniciar mi evaluación
      </a>
    </section>
  </main>
  <footer class="landing-footer">
    <p>SOCIEDAD 52 · MÉXICO</p>
    <span>Acceso privado. Evaluación personal.</span>
    <a href="/aviso-de-privacidad/" target="_blank">Aviso de privacidad</a>
  </footer>

  <script define:vars={{ WHATSAPP_NUMBER }}>
    const form = document.getElementById('sociedad-application-form');
    const participationInputs = Array.from(
      form?.querySelectorAll('input[name="participacion"]') || []
    );
    const categoryInputs = Array.from(
      form?.querySelectorAll('input[name="categorias"]') || []
    );
    const steps = Array.from(form?.querySelectorAll('.form-step') || []);
    const backButton = document.getElementById('form-back');
    const nextButton = document.getElementById('form-next');
    const submitButton = document.getElementById('form-submit');
    const currentStepLabel = document.getElementById('current-step');
    const progressFill = document.getElementById('progress-fill');
    let currentStep = 1;

    const showStep = (stepNumber) => {
      currentStep = stepNumber;
      steps.forEach((step) => {
        const isCurrent = Number(step.getAttribute('data-step')) === currentStep;
        step.hidden = !isCurrent;
        step.classList.toggle('active', isCurrent);
      });
      if (currentStepLabel) currentStepLabel.textContent = String(currentStep);
      if (progressFill) progressFill.style.width = `${(currentStep / steps.length) * 100}%`;
      if (backButton) backButton.hidden = currentStep === 1;
      if (nextButton) nextButton.hidden = currentStep === steps.length;
      if (submitButton) submitButton.hidden = currentStep !== steps.length;
    };

    const validateCurrentStep = () => {
      const step = steps.find(
        (item) => Number(item.getAttribute('data-step')) === currentStep
      );
      if (!step) return true;

      const fields = Array.from(step.querySelectorAll('input, select, textarea'));
      for (const field of fields) {
        if (!field.reportValidity()) return false;
      }

      if (currentStep === 2) {
        const participation = participationInputs.filter((input) => input.checked);
        const categories = categoryInputs.filter((input) => input.checked);

        if (participation.length === 0) {
          participationInputs[0]?.setCustomValidity('Selecciona al menos una forma de participación.');
          participationInputs[0]?.reportValidity();
          return false;
        }
        if (categories.length === 0) {
          categoryInputs[0]?.setCustomValidity('Selecciona al menos una categoría de interés.');
          categoryInputs[0]?.reportValidity();
          return false;
        }
      }

      return true;
    };

    [...participationInputs, ...categoryInputs].forEach((input) => {
      input.addEventListener('change', () => {
        participationInputs[0]?.setCustomValidity('');
        categoryInputs[0]?.setCustomValidity('');
      });
    });

    nextButton?.addEventListener('click', () => {
      if (!validateCurrentStep()) return;
      showStep(Math.min(currentStep + 1, steps.length));
      form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    backButton?.addEventListener('click', () => {
      showStep(Math.max(currentStep - 1, 1));
      form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.querySelectorAll('[data-cta]').forEach((element) => {
      element.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'sociedad_52_cta',
          cta: element.getAttribute('data-cta'),
        });
      });
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const participation = data.getAll('participacion');
      const categories = data.getAll('categorias');

      if (participation.length === 0) {
        participationInputs[0]?.setCustomValidity('Selecciona al menos una forma de participación.');
        participationInputs[0]?.reportValidity();
        return;
      }

      if (categories.length === 0) {
        categoryInputs[0]?.setCustomValidity('Selecciona al menos una categoría de interés.');
        categoryInputs[0]?.reportValidity();
        return;
      }

      const message = [
        'Hola Ramon, quiero enviar mi evaluación para la cohorte fundadora de Sociedad 52.',
        '',
        'Origen: landing Sociedad 52',
        `Nombre: ${data.get('nombre')}`,
        `WhatsApp: ${data.get('whatsapp')}`,
        `Correo: ${data.get('correo')}`,
        `Ciudad: ${data.get('ciudad')}`,
        `Actividad: ${data.get('actividad')}`,
        `Perfil verificable: ${data.get('perfil') || 'No indicado'}`,
        `Recomendado por: ${data.get('referido') || 'Sin recomendación indicada'}`,
        `Participación: ${participation.join(', ')}`,
        `Categorías: ${categories.join(', ')}`,
        `Qué puedo aportar: ${data.get('aporte')}`,
        `Qué espero encontrar: ${data.get('busca')}`,
        `Oportunidad o necesidad actual: ${data.get('oportunidad')}`,
        `Relación con SWIP: ${data.get('relacion_swip')}`,
        `Por qué considerarme: ${data.get('motivo')}`,
        '',
        'Entiendo que la Comunidad abrirá al conformar la generación completa y que esta solicitud no garantiza admisión.',
      ].join('\n');

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'sociedad_52_application_submitted',
        participation_profiles: participation.join('|'),
        interest_categories: categories.join('|'),
        has_referral: Boolean(data.get('referido')),
        swip_relationship: data.get('relacion_swip'),
      });

      window.open(
        `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`,
        '_blank',
        'noopener'
      );
    });

    showStep(1);
  </script>
</Base>

<style>
  main { padding-top: 0; }

  [hidden] { display: none !important; }

  :global(html),
  :global(body) {
    overflow-x: hidden;
  }

  .landing-header {
    min-height: 70px;
    padding: 0 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid var(--line);
    background: #090909;
  }

  .landing-header p,
  .landing-header span,
  .landing-footer p,
  .landing-footer span,
  .landing-footer a {
    font-size: 9px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .landing-header p { color: rgba(255, 255, 255, 0.92); }
  .landing-header span { color: rgba(168, 168, 168, 0.38); }

  #estandar,
  #espacios,
  #admision,
  #solicitud {
    scroll-margin-top: 72px;
  }

  .hero {
    width: 100%;
    max-width: 1440px;
    min-height: 760px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .hero-copy {
    min-width: 0;
    padding: 112px 72px 96px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow,
  .section-eyebrow {
    font-size: 9px;
    letter-spacing: 0.4em;
    color: rgba(168, 168, 168, 0.42);
    text-transform: uppercase;
  }

  .eyebrow { margin-bottom: 28px; }

  .hero h1 {
    max-width: 760px;
    font-size: clamp(56px, 6.2vw, 94px);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.94;
    color: var(--white);
  }

  .hero h1 em {
    display: inline-block;
    color: rgba(168, 168, 168, 0.5);
    font-style: normal;
  }

  .hero-body {
    max-width: 660px;
    margin-top: 32px;
    font-size: 16px;
    line-height: 1.85;
    color: rgba(168, 168, 168, 0.76);
  }

  .founding-statement {
    max-width: 620px;
    margin-top: 22px;
    padding-left: 18px;
    border-left: 1px solid rgba(255, 255, 255, 0.26);
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 38px;
  }

  .btn-primary,
  .form-submit,
  .form-next,
  .form-back {
    min-height: 52px;
    padding: 16px 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: none;
    color: var(--white);
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary:hover,
  .form-submit:hover,
  .form-next:hover,
  .form-back:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .btn-ghost {
    min-height: 44px;
