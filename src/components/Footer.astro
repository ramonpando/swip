---
export interface Props {
  context?: 'vehicle' | 'watch' | 'community';
}

const { context = 'vehicle' } = Astro.props;
const isWatch = context === 'watch';
const isCommunity = context === 'community';
const preserveMessage = isWatch || isCommunity;
const WHATSAPP = isCommunity
  ? 'https://wa.me/5215542317035?text=Hola%20Ramon%2C%20quiero%20solicitar%20consideraci%C3%B3n%20para%20Sociedad%2052'
  : isWatch
    ? 'https://wa.me/5215542317035?text=Hola%20Ramon%2C%20vi%20el%20piloto%20de%20relojes%20de%20SWIP%20y%20quiero%20solicitar%20una%20evaluaci%C3%B3n%20privada'
    : 'https://wa.me/5215554055089?text=Hola%2C%20quiero%20solicitar%20una%20evaluaci%C3%B3n%20de%20mi%20veh%C3%ADculo';
const brandLine1 = isCommunity ? 'Sociedad 52' : 'Liquidez inteligente';
const brandLine2 = isCommunity
  ? 'Conexiones con criterio.'
  : isWatch
    ? 'Con respaldo en activos premium.'
    : 'Con respaldo en tu auto.';
const contactNumber = isCommunity || isWatch ? '55 4231 7035' : '55 5405 5089';
const contactHref = isCommunity || isWatch ? 'tel:+525542317035' : 'tel:+525554055089';
const contactCta = isCommunity
  ? 'Iniciar evaluación'
  : isWatch
    ? 'Evalúa tu reloj'
    : 'Cotiza tu préstamo';
---
<footer class="swip-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a href="/">
        <img src="/assets/logos/logo-light.svg" alt="SWIP" width="77" height="30" />
      </a>
      <p class="tagline">
        {brandLine1}<br />
        {brandLine2}
      </p>
    </div>

    <div class="footer-col">
      <p class="col-title">Activos y servicios</p>
      <a href="/prestamo-con-garantia-de-auto/">Préstamo con garantía de auto</a>
      <a href="/prestamo-con-garantia-de-auto-sin-dejarlo/">Sin dejarlo</a>
      <a href="/prestamo-con-garantia-de-auto-con-resguardo/">Con resguardo</a>
      <a href="/prestamo-con-garantia-de-autos-de-lujo/">Autos de lujo</a>
      <a href="/prestamo-con-garantia-de-autos-blindados/">Autos blindados</a>
      <a href="/financiamiento-con-inventario-vehicular/">Capital para empresas</a>
      <a href="/prestamo-con-garantia-de-reloj/">Relojes de lujo · Piloto</a>
      <a href="/sociedad-52/">Sociedad 52 · Founding 52</a>
    </div>

    <div class="footer-col">
      <p class="col-title">Información</p>
      <a href="/por-que-swip/">Por qué SWIP</a>
      <a href="/como-funciona/">Cómo funciona</a>
      <a href="/requisitos/">Requisitos</a>
      <a href="/vehiculos-que-aceptamos/">Vehículos que aceptamos</a>
      <a href="/preguntas-frecuentes/">Preguntas frecuentes</a>
      <a href="/blog/">Blog</a>
    </div>

    <div class="footer-col">
      <p class="col-title">Contacto</p>
      <a href="mailto:patricia_bernal@swip.mx" style="text-transform:none;letter-spacing:0;">patricia_bernal@swip.mx</a>
      <a
        href={contactHref}
        style="text-transform:none;letter-spacing:0;"
      >
        {contactNumber}
      </a>
      <a href={WHATSAPP} target="_blank" rel="noopener" data-preserve-message={preserveMessage || undefined}>WhatsApp</a>
      <a href={WHATSAPP} target="_blank" rel="noopener" data-preserve-message={preserveMessage || undefined}>{contactCta}</a>
      <p class="footer-address">Pje. Interlomas 6, Naucalpan,<br />Estado de México, 52787</p>
    </div>
  </div>

  <div class="footer-bottom">
    <span class="copy">© 2026 SWIP. Todos los derechos reservados.</span>
    <div class="legal">
      <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
      <a href="/terminos-de-uso/">Términos de uso</a>
    </div>
  </div>
</footer>

<style>
  .swip-footer {
    border-top: 1px solid var(--line);
  }

  .footer-main {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
    padding: 80px 64px 60px;
  }

  .footer-brand .tagline {
    font-size: 12px;
    color: rgba(168, 168, 168, 0.44);
    line-height: 1.7;
    margin-top: 20px;
  }

  .col-title {
    font-size: 9px;
    letter-spacing: 0.38em;
    color: rgba(168, 168, 168, 0.3);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .footer-col a {
    display: block;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: rgba(168, 168, 168, 0.62);
    text-decoration: none;
    margin-bottom: 12px;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer-col a:hover { color: var(--white); }

  .footer-bottom {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 64px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copy {
    font-size: 11px;
    color: rgba(168, 168, 168, 0.32);
    letter-spacing: 0.08em;
  }

  .legal {
    display: flex;
    gap: 32px;
  }

  .legal a {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: rgba(168, 168, 168, 0.32);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .legal a:hover { color: rgba(255, 255, 255, 0.7); }

  .footer-address {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(168, 168, 168, 0.35);
    line-height: 1.7;
    margin-top: 16px;
    text-transform: none;
  }

  @media (max-width: 1024px) {
    .footer-main { grid-template-columns: 1fr 1fr; gap: 40px; padding: 56px 24px 40px; }
  }

  @media (max-width: 768px) {
    .footer-main { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; padding: 20px 24px; gap: 12px; }
  }
</style>
