---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  date: string;
  updatedDate?: string;
  category: string;
  slug: string;
  image?: string;
  seoTitle?: string;
  seoDescription?: string;
  relatedPosts?: Array<{
    title: string;
    description: string;
    category: string;
    slug: string;
  }>;
}

const {
  title,
  description,
  date,
  updatedDate,
  category,
  slug,
  image,
  seoTitle,
  seoDescription,
  relatedPosts = [],
} = Astro.props;

const isWatchArticle = category.toLocaleLowerCase('es-MX').includes('relojes');
const isBusinessArticle = category.toLocaleLowerCase('es-MX').includes('capital empresarial');

const canonical = `https://swip.mx/blog/${slug}/`;
const blogIndex = 'https://swip.mx/blog/';
const defaultArticleImage = `https://swip.mx/assets/blog/${slug}.jpg`;
const articleImage = image ?? defaultArticleImage;

const truncateMeta = (value: string, maxLength: number) => {
  if (value.length <= maxLength) return value;
  const shortened = value.slice(0, maxLength - 1);
  const lastSpace = shortened.lastIndexOf(' ');
  return `${shortened.slice(0, lastSpace > 90 ? lastSpace : maxLength - 1).trim()}…`;
};

const brandedTitle = `${seoTitle ?? title} | SWIP`;
const metaTitle = brandedTitle.length <= 65
  ? brandedTitle
  : truncateMeta(seoTitle ?? title, 65);
const metaDescription = seoDescription ?? truncateMeta(description, 160);
const dateFormatted = new Date(date).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedDateFormatted = updatedDate && new Date(updatedDate).toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  "headline": title,
  "description": description,
  "datePublished": date,
  ...(updatedDate ? { "dateModified": updatedDate } : {}),
  "inLanguage": "es-MX",
  "articleSection": category,
  "isPartOf": {
    "@id": `${blogIndex}#webpage`,
  },
  ...(isBusinessArticle ? {
    "about": [
      {
        "@type": "Thing",
        "name": "Capital de trabajo",
      },
      {
        "@type": "Thing",
        "name": "Inventario vehicular",
      },
      {
        "@type": "Thing",
        "name": "Financiamiento empresarial",
      },
    ],
    "keywords": "capital de trabajo, inventario vehicular, financiamiento empresarial, garantía vehicular",
  } : {}),
  "mainEntityOfPage": canonical,
  "author": {
    "@type": "Person",
    "@id": "https://swip.mx/autor/ramon-pando/#person",
    "name": "Ramon Pando Rodriguez",
    "jobTitle": "Fundador y Director General",
    "url": "https://swip.mx/autor/ramon-pando/",
    "worksFor": {
      "@id": "https://swip.mx/#organization",
    },
  },
  "publisher": {
    "@type": "Organization",
    "name": "SWIP",
    "url": "https://swip.mx",
    "logo": {
      "@type": "ImageObject",
      "url": "https://swip.mx/assets/logos/logo-light.svg",
    },
  },
  "image": {
    "@type": "ImageObject",
    "url": articleImage,
    "width": 1200,
    "height": 630,
  },
};

const WHATSAPP = 'https://wa.me/5215554055089?text=Hola%2C%20quiero%20cotizar%20un%20pr%C3%A9stamo%20con%20garant%C3%ADa%20de%20mi%20veh%C3%ADculo';
const WATCH_WHATSAPP = 'https://wa.me/5215542317035?text=Hola%20Ramon%2C%20le%C3%AD%20un%20art%C3%ADculo%20de%20relojes%20en%20SWIP%20y%20quiero%20solicitar%20una%20evaluaci%C3%B3n%20privada';
const BUSINESS_WHATSAPP = 'https://wa.me/5215554055089?text=Hola%2C%20le%C3%AD%20las%20gu%C3%ADas%20de%20capital%20empresarial%20de%20SWIP%20y%20quiero%20evaluar%20inventario%20vehicular%20propio';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://swip.mx/",
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": blogIndex,
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonical,
    },
  ],
};
---

<Base
  title={metaTitle}
  description={metaDescription}
  canonical={canonical}
  ogImage={articleImage}
  ogType="article"
  publishedTime={date}
  modifiedTime={updatedDate}
  schema={[articleSchema, breadcrumbSchema]}
>
  <Nav context={isWatchArticle ? 'watch' : 'vehicle'} />
  <main>
    <section class="article-hero">
      <div class="article-inner">
        <a href="/blog/" class="back-link">← Volver al blog</a>
        <p class="article-category">{category}</p>
        <h1 class="article-title">{title}</h1>
        <p class="article-meta">
          <span>Publicado <time datetime={date}>{dateFormatted}</time></span>
          {updatedDate && updatedDateFormatted && (
            <span> · Actualizado <time datetime={updatedDate}>{updatedDateFormatted}</time></span>
          )}
        </p>
        <p class="article-description">{description}</p>
      </div>
    </section>

    <article class="article-body">
      <div class="article-inner prose">
        <slot />
      </div>
    </article>

    {relatedPosts.length > 0 && (
      <section class="article-related" aria-labelledby="related-title">
        <div class="related-inner">
          <p class="related-eyebrow">CONTINÚA EXPLORANDO</p>
          <h2 id="related-title" class="related-title">Artículos relacionados</h2>
          <div class="related-grid">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.slug}/`} class="related-card">
                <p class="related-category">{post.category}</p>
                <h3>{post.title}</h3>
                <p>{post.description}</p>
                <span>Leer artículo →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="article-author">
      <div class="article-inner author-inner">
        <div class="author-card">
          <div class="author-text">
            <p class="author-name"><a href="/autor/ramon-pando/" rel="author">Ramon Pando Rodriguez</a></p>
            <p class="author-role">Fundador y Director General, SWIP</p>
            <p class="author-bio">Fundó SWIP en 2023 para estructurar liquidez respaldada por vehículos de alto valor. Participa directamente en la evaluación de activos complejos, incluidos blindados, exóticos y vehículos de producción limitada.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="article-sources" aria-labelledby="sources-title">
      <div class="article-inner">
        <p class="article-category">METODOLOGÍA Y FUENTES</p>
        <h2 id="sources-title">Cómo verificamos la información.</h2>
        <p>
          Los rangos publicados son estimaciones editoriales de SWIP basadas en experiencia operativa,
          referencias observables de mercado, versión, condición, documentación y liquidez del activo.
          No constituyen una oferta: el monto final se determina después de la revisión física y documental.
        </p>
        {isWatchArticle ? (
          <ul>
            <li><a href="https://www.rolex.com/es-es/buying-a-rolex/rolex-certified-pre-owned" target="_blank" rel="noopener noreferrer">Rolex Certified Pre-Owned: autenticidad y certificación oficial</a></li>
            <li><a href="https://www.rolex.com/es/watch-care-and-service/faq" target="_blank" rel="noopener noreferrer">Rolex: mantenimiento, autenticidad y distribuidores oficiales</a></li>
            <li><a href="https://www.cartier.com/es-es/warranty-and-authenticity" target="_blank" rel="noopener noreferrer">Cartier: garantía y autenticidad</a></li>
          </ul>
        ) : isBusinessArticle ? (
          <ul>
            <li><a href="https://www.gob.mx/nafin/acciones-y-programas/financiamiento-para-distribuidores-automotrices-plan-piso" target="_blank" rel="noopener noreferrer">NAFIN: definición oficial de financiamiento Plan Piso</a></li>
            <li><a href="https://www.gob.mx/sesnsp/acciones-y-programas/registro-publico-vehicular-repuve-168639" target="_blank" rel="noopener noreferrer">REPUVE: situación e información oficial del vehículo</a></li>
            <li><a href="/financiamiento-con-inventario-vehicular/">Criterios empresariales de inventario vehicular de SWIP</a></li>
            <li><a href="/blog/como-valuamos-un-auto-proceso-real/">Metodología operativa de valuación de SWIP</a></li>
          </ul>
        ) : (
          <ul>
            <li><a href="https://www.gob.mx/sesnsp/acciones-y-programas/registro-publico-vehicular-repuve-168639" target="_blank" rel="noopener noreferrer">REPUVE: situación e información oficial del vehículo</a></li>
            <li><a href="https://rcal.profeco.gob.mx/contratostipo/MUTUO%20CON%20INTERES%20Y%20GARANTIA%20PRENDARIA%20%28PROFECO%29.pdf" target="_blank" rel="noopener noreferrer">PROFECO: contrato tipo de mutuo con interés y garantía prendaria</a></li>
            <li><a href="/blog/como-valuamos-un-auto-proceso-real/">Metodología operativa de valuación de SWIP</a></li>
          </ul>
        )}
      </div>
    </section>

    <section class="article-cta">
      <div class="article-inner cta-inner">
        <p class="cta-eyebrow">SIGUIENTE PASO</p>
        {isWatchArticle ? (
          <>
            <h2 class="cta-title">Empieza con una evaluación privada.</h2>
            <p class="cta-body">
              Comparte la referencia de tu reloj y el monto que buscas. Ramon Pando,
              fundador de SWIP, atenderá personalmente tu solicitud y te dirá si
              vale la pena avanzar a una revisión física.
            </p>
            <div class="cta-actions">
              <a href={WATCH_WHATSAPP} target="_blank" rel="noopener" data-preserve-message class="btn-primary">Evaluar mi reloj</a>
              <a href="/prestamo-con-garantia-de-reloj/" class="btn-ghost">Ver cómo funciona →</a>
            </div>
          </>
        ) : isBusinessArticle ? (
          <>
            <h2 class="cta-title">Evalúa el inventario propio de tu empresa.</h2>
            <p class="cta-body">
              Comparte una lista inicial de unidades, quién acredita la propiedad
              y cuánto capital necesita la operación. SWIP filtrará primero el
              expediente antes de programar las valuaciones físicas.
            </p>
            <div class="cta-actions">
              <a href={BUSINESS_WHATSAPP} target="_blank" rel="noopener" class="btn-primary">Evaluar mi inventario</a>
              <a href="/financiamiento-con-inventario-vehicular/" class="btn-ghost">Ver el servicio empresarial →</a>
            </div>
          </>
        ) : (
          <>
            <h2 class="cta-title">Convierte la información en una valuación real.</h2>
            <p class="cta-body">
              Si tu vehículo tiene valor y quieres saber cuánto puedes obtener,
              pasa a la evaluación con el equipo de SWIP.
            </p>
            <div class="cta-actions">
              <button onclick="openSwipModal()" class="btn-primary">Cotiza tu préstamo</button>
              <a href="/prestamo-con-garantia-de-auto/" class="btn-ghost">Ver el servicio completo →</a>
            </div>
          </>
        )}
      </div>
    </section>
  </main>
  <Footer context={isWatchArticle ? 'watch' : 'vehicle'} />
</Base>

<style is:global>
  main {
    padding-top: 61px;
  }

  .article-hero,
  .article-body,
  .article-related,
  .article-cta {
    border-bottom: 1px solid var(--line);
  }

  .article-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 88px 64px;
  }

  .article-hero .article-inner {
    padding-bottom: 72px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: rgba(168, 168, 168, 0.54);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--white);
  }

  .article-category {
    font-size: 9px;
    letter-spacing: 0.42em;
    color: rgba(168, 168, 168, 0.42);
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .article-title {
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 400;
    color: var(--white);
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin-bottom: 18px;
  }

  .article-meta {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(168, 168, 168, 0.38);
    text-transform: uppercase;
    margin-bottom: 28px;
  }

  .article-description {
    max-width: 680px;
    font-size: 16px;
    line-height: 1.9;
    color: rgba(168, 168, 168, 0.78);
  }

  .prose {
    font-size: 17px;
    line-height: 1.95;
    color: rgba(168, 168, 168, 0.78);
  }

  .prose > *:first-child {
    margin-top: 0;
  }

  .prose h2 {
    font-size: 34px;
    font-weight: 300;
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 1.08;
    margin: 56px 0 20px;
  }

  .prose h3 {
    font-size: 24px;
    font-weight: 400;
    color: var(--white);
    letter-spacing: -0.01em;
    margin: 40px 0 16px;
  }

  .prose p {
    margin-bottom: 22px;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 24px 24px;
  }

  .prose li {
    margin-bottom: 10px;
  }

  .prose strong {
    color: var(--white);
    font-weight: 500;
  }

  .prose a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose blockquote {
    border-left: 2px solid rgba(255, 255, 255, 0.14);
    padding-left: 22px;
    margin: 36px 0;
    color: rgba(168, 168, 168, 0.66);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 40px 0;
    font-size: 15px;
  }

  .prose th,
  .prose td {
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }

  .prose th {
    color: var(--white);
    font-weight: 400;
  }

  .article-author {
    border-bottom: 1px solid var(--line);
  }

  .article-sources {
    border-bottom: 1px solid var(--line);
  }

  .article-sources h2 {
    color: var(--white);
    font-size: 30px;
    font-weight: 300;
    margin: 0 0 20px;
  }

  .article-sources p,
  .article-sources li {
    color: rgba(168, 168, 168, 0.72);
    font-size: 14px;
    line-height: 1.8;
  }

  .article-sources ul {
    margin: 24px 0 0 20px;
  }

  .article-sources li {
    margin-bottom: 8px;
  }

  .article-sources a,
  .author-name a {
    color: var(--white);
    text-underline-offset: 3px;
  }

  .related-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 64px;
  }

  .related-eyebrow {
    font-size: 9px;
    letter-spacing: 0.42em;
    color: rgba(168, 168, 168, 0.4);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .related-title {
    font-size: clamp(30px, 3.5vw, 46px);
    font-weight: 300;
    color: var(--white);
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px;
    color: inherit;
    background: var(--black);
    text-decoration: none;
    transition: background 0.2s;
  }

  .related-card:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .related-category {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: rgba(168, 168, 168, 0.4);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .related-card h3 {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--white);
    margin-bottom: 14px;
  }

  .related-card > p:last-of-type {
    flex: 1;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(168, 168, 168, 0.64);
    margin-bottom: 24px;
  }

  .related-card span {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(168, 168, 168, 0.56);
    text-transform: uppercase;
  }

  .author-inner {
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .author-card {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .author-name {
    font-size: 15px;
    font-weight: 500;
    color: var(--white);
    margin-bottom: 4px;
  }

  .author-role {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(168, 168, 168, 0.45);
    margin-bottom: 14px;
  }

  .author-bio {
    font-size: 14px;
    line-height: 1.85;
    color: rgba(168, 168, 168, 0.62);
    max-width: 620px;
    margin-bottom: 0;
  }

  .cta-inner {
    text-align: center;
  }

  .cta-eyebrow {
    font-size: 9px;
    letter-spacing: 0.42em;
    color: rgba(168, 168, 168, 0.4);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .cta-title {
    font-size: clamp(30px, 3.8vw, 52px);
    font-weight: 300;
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .cta-body {
    max-width: 560px;
    margin: 0 auto 34px;
    font-size: 15px;
    line-height: 1.85;
    color: rgba(168, 168, 168, 0.72);
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 16px 40px;
    border: 1px solid rgba(255,255,255,0.35);
    color: var(--white);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-family: inherit;
    background: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary:hover {
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.6);
  }

  .btn-ghost {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: rgba(168,168,168,0.6);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
  }

  .btn-ghost:hover {
    color: var(--white);
  }

  @media (max-width: 768px) {
    .article-inner {
      padding: 64px 24px;
    }

    .related-inner {
      padding: 56px 24px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
